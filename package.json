{
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3000 --open",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "backend": "json-server --watch db.json",
    "test": "npm run test:unit && npm run test:e2e:ci",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --ui",
    "test:e2e:ci": "playwright test",
    "playwright:install": "playwright install --with-deps --no-shell chromium",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@primevue/forms": "^4.4.1",
    "@tailwindcss/vite": "^4.1.16",
    "ky": "^1.13.0",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "tailwindcss-primeui": "^0.6.1",
    "valibot": "^1.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.0.0",
    "@iconify/vue": "^5.0.0",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.56.1",
    "@primevue/auto-import-resolver": "^4.4.1",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.38.0",
    "happy-dom": "^20.0.8",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^30.0.0",
    "vite": "npm:rolldown-vite@^7.1.20",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.3",
    "vue-tsc": "^3.1.2"
  }
}
